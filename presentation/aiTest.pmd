{
  "id": "aiTest",
  "endPoints": [
    {
      "name": "getPositions",
      "httpMethod": "GET",
      "authType": "sso",
      "_generationNote": "Gets a collection of Position business objects. By default, this endpoint returns 20 instances. To increase the page size, use the 'limit' query parameter (e.g. ?limit=100).",
      "_generationNote2": "If there are more than 100 instances, consider using a search endpoint or another way for the user to filter the available selections.",
      "url": "<% `https://api.us.wcp.workday.com/apps/{{site.applicationId}}/v1/positions` %>",
      "isCollection": true
    },
    {
      "name": "aiModel",
      "url": "https://cloud.flowiseai.com/api/v1/prediction/10cabc81-ffb7-456c-bffb-5a30b5861fd3",
      "authType": "noAuth",
      "httpMethod": "POST",
      "deferred": true,
      "onSend": "<%
        {
          'question' : questionWidget.value
        } 
      %>"
    }
  ],
  "presentation": {
    "pageType": "edit",
    "title": {
      "type": "title",
      "label": "Workday Extend"
    },
    "body": {
      "type": "section",
      "horizontal": false,
      "children": [
        {
          "type": "textArea",
          "id": "questionWidget",
          "label": "Ask your question here",
          "value": "<% getPositions %>"
        },
        {
          "type": "pageActionButton",
          "label": "Send",
          "onClick": "<%
            let response = aiModel.invoke();
            responseWidget.setValue(response.text)
          %>"
        },
        {
          "type": "textArea",
          "id": "responseWidget",
          "label": "Response",
          "enabled": "false"
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "richText",
          "enabled": "false",
          "value": "Powered By Workday Extend"
        }
      ]
    }
  }
}