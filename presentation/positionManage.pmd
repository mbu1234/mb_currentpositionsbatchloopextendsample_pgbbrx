{
  "id": "positionManage",
  "_generationNote": "This page is designed for app administrators to quickly manage Position business object data for the app. ",
  "_generationNote2": "It is strongly advised to configure the `securityDomains` for this page to allow only the appropriate personas to access it.",
  "securityDomains": [ ],
  "script": "",
  "endPoints": [
    {
      "name": "getPositions",
      "httpMethod": "GET",
      "authType": "sso",
      "_generationNote": "Gets a collection of Position business objects. By default, this endpoint returns 20 instances. To increase the page size, use the 'limit' query parameter (e.g. ?limit=100).",
      "_generationNote2": "If there are more than 100 instances, consider using a search endpoint or another way for the user to filter the available selections.",
      "url": "<% `https://api.us.wcp.workday.com/apps/{{site.applicationId}}/v1/positions` %>",
      "isCollection": true
    }
  ],
  "outboundData": {
    "_generationNote": "All of the outboundEndPoints will be invoked for every row of the grid upon the submission of the page.",
    "_generationNote2": "This is because the cellTemplate valueOutBinding attributes reference the corresponding endpoint for create and update. The grid deleteEndPoint references the delete.",
    "outboundEndPoints": [
      {
        "_generationNote": "Creates a single instance, as specified by the Position data from the valueOutBinding attributes in the grid cellTemplates.",
        "name": "createPosition",
        "url": "<% `https://api.us.wcp.workday.com/apps/{{site.applicationId}}/v1/positions` %>",
        "_generationNote2": "To ensure it is only invoked for rows the user has added, the exclude condition checks that the `id` cell is not populated.",
        "exclude": "<% ! (empty positionId.value) %>",
        "authType": "sso",
        "httpMethod": "POST",
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          }
        ]
      },
      {
        "_generationNote": "Updates a single instance, as specified by `positionId.value` from the business object id field in the cellTemplate.",
        "name": "updatePosition",
        "url": "<% `https://api.us.wcp.workday.com/apps/{{site.applicationId}}/v1/positions/{{positionId.value}}` %>",
        "_generationNote2": "To ensure it is only invoked for existing rows, the exclude condition checks that the `id` cell value is already present.",
        "exclude": "<% empty positionId.value %>",
        "authType": "sso",
        "httpMethod": "PUT",
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          }
        ]
      },
      {
        "_generationNote": "Deletes a single instance, as specified by `positionId.value` from the business object id field in the cellTemplate.",
        "_generationNote2": "The deleteEndPoint attribute of the grid references this endpoint, which will be invoked for each deleted row upon the submission of the page.",
        "name": "deletePosition",
        "url": "<% `https://api.us.wcp.workday.com/apps/{{site.applicationId}}/v1/positions/{{positionId.value}}` %>",
        "authType": "sso",
        "httpMethod": "DELETE",
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          }
        ]
      }
    ],
    "responseErrorDetail": {
      "_generationNote": "This responseErrorDetail works with the Workday API error structure.",
      "_generationNote2": "If there is only a single error, the errorSummary will be shown.",
      "errorSummary": "<% error %>",
      "_generationNote3": "For multiple errors, append the top-level error to provide context.",
      "errors": "<% empty errors ? [] : [error].join(errors.map(err => { err.error } )) %>"
    }
  },
  "presentation": {
    "pageType": "edit",
    "title": {
      "type": "title",
      "id": "title",
      "label": "Manage Position"
    },
    "body": {
      "id": "bodySection",
      "type": "section",
      "children": [
        {
          "_generationNote": "This grid is populated via the `rows` property with all of the data retrieved from the Businessobject API.",
          "_generationNote2": "Upon submission, each row will be individually checked to either create, update, or delete the specified instance. The corresponding endpoint will be invoked for each row.",
          "type": "grid",
          "gridType": "LIST",
          "id": "positionGrid",
          "rows": "<% getPositions.data %>",
          "rowVariableName": "position",
          "deleteEndPoint": "deletePosition",
          "columns": [
            {
              "type": "column",
              "columnId": "positionIdColumn",
              "label": "Id",
              "cellTemplate": {
                "type": "text",
                "id": "positionId",
                "_generationNote": "The `id` is the primary way Workday manages instances. This value will only be populated for existing instances.",
                "value": "<% position.id %>",
                "enabled": false,
                "valuesOut": [
                  {
                    "valueOutBinding": "createPosition.id",
                    "value": "<% self.value %>"
                  },
                  {
                    "valueOutBinding": "updatePosition.id",
                    "value": "<% self.value %>"
                  }
                ]
              }
            },
            {
              "sortableAndFilterable": true,
              "type": "column",
              "columnId": "positionIDColumn",
              "label": "Position I D",
              "cellTemplate": {
                "type": "text",
                "id": "positionID",
                "value": "<% position.positionID %>",
                "valuesOut": [
                  {
                    "valueOutBinding": "createPosition.positionID",
                    "value": "<% self.value %>"
                  },
                  {
                    "valueOutBinding": "updatePosition.positionID",
                    "value": "<% self.value %>"
                  }
                ]
              }
            },
            {
              "sortableAndFilterable": true,
              "type": "column",
              "columnId": "effectiveDateColumn",
              "label": "Effective Date",
              "cellTemplate": {
                "type": "date",
                "id": "effectiveDateID",
                "value": "<% position.effectiveDate %>",
                "valuesOut": [
                  {
                    "valueOutBinding": "createPosition.effectiveDate",
                    "value": "<% self.value %>"
                  },
                  {
                    "valueOutBinding": "updatePosition.effectiveDate",
                    "value": "<% self.value %>"
                  }
                ]
              }
            },
            {
              "sortableAndFilterable": true,
              "type": "column",
              "columnId": "positionTitleColumn",
              "label": "Position Title",
              "cellTemplate": {
                "type": "text",
                "id": "positionTitle",
                "value": "<% position.positionTitle %>",
                "valuesOut": [
                  {
                    "valueOutBinding": "createPosition.positionTitle",
                    "value": "<% self.value %>"
                  },
                  {
                    "valueOutBinding": "updatePosition.positionTitle",
                    "value": "<% self.value %>"
                  }
                ]
              }
            },
            {
              "sortableAndFilterable": true,
              "type": "column",
              "columnId": "criticalJobColumn",
              "label": "Critical Job",
              "cellTemplate": {
                "type": "text",
                "id": "criticalJob",
                "value": "<% position.criticalJob %>",
                "valuesOut": [
                  {
                    "valueOutBinding": "createPosition.criticalJob",
                    "value": "<% self.value %>"
                  },
                  {
                    "valueOutBinding": "updatePosition.criticalJob",
                    "value": "<% self.value %>"
                  }
                ]
              }
            },
            {
              "sortableAndFilterable": true,
              "type": "column",
              "columnId": "orgIDColumn",
              "label": "Supervisory Org",
              "cellTemplate": {
                "type": "text",
                "id": "orgID",
                "value": "<% position.supervisoryOrg.split('_').remove('SUPERVISORY').join(' '); %>",
                "valuesOut": [
                  {
                    "valueOutBinding": "createPosition.supervisoryOrg",
                    "value": "<% self.value %>"
                  },
                  {
                    "valueOutBinding": "updatePosition.supervisoryOrg",
                    "value": "<% self.value %>"
                  }
                ]
              }
            },
            {
              "sortableAndFilterable": true,
              "type": "column",
              "columnId": "diffFillCodeColumn",
              "label": "Easy to Fill Ref Code",
              "cellTemplate": {
                "type": "text",
                "id": "easyFillCode",
                "value": "<% position.easyToFillRef %>",
                "valuesOut": [
                  {
                    "valueOutBinding": "createPosition.easyToFillRef",
                    "value": "<% self.value %>"
                  },
                  {
                    "valueOutBinding": "updatePosition.easyToFillRef",
                    "value": "<% self.value %>"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "id": "footer",
      "children": [
        {
          "type": "richText",
          "id": "footerText",
          "enabled": "false",
          "value": "Powered By Workday Extend"
        }
      ]
    }
  }
}